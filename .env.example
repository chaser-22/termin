# Postgres connection (Neon on Vercel). Leave unset locally to use the
# embedded database in .data/pglite.
DATABASE_URL=

# Public address of the app, used in emails and links. Optional; detected
# from the request when unset.
APP_URL=

# Email through Resend (free tier). Without these, emails are printed to the
# server log and, in development, sign-in links are shown on screen.
RESEND_API_KEY=
EMAIL_FROM="Termin <no-reply@your-domain.me>"

# Protects /api/cron/reminders (client reminders). Vercel Cron sends it
# automatically once set in the project. Any long random string.
CRON_SECRET=

# SMS reminders for clients who left no email (Infobip; the same account can
# later send Viber business messages). Without these, SMS go to the server log.
# INFOBIP_BASE_URL is the personal API address shown in your Infobip account.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
SMS_FROM=Termin
