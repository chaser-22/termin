# Postgres connection (Neon on Vercel). Leave unset locally to use the
# embedded database in .data/pglite.
DATABASE_URL=

# Public address of the app, used in emails and links. Optional; detected
# from the request when unset.
APP_URL=

# Email through Resend (free tier). Without these, emails are printed to the
# server log and, in development, sign-in links are shown on screen.
RESEND_API_KEY=
EMAIL_FROM="Termin <no-reply@your-domain.me>"
